{
  "name": "Fair Winds",
  "executable_path": "/usr/local/bin/python3",
  "args": ["{install_dir}/fair_winds.py"],
  "profile": {
    "version": 1,
    "adapter": "native",
    "endpoint": "stdio",
    "install_dir": "/var/games/netbbs/fair-winds",
    "encoding": "utf-8",
    "width": 0,
    "height": 0,
    "resize_signal": true,
    "time_limit": 3600,
    "cpu_seconds": 900,
    "max_sessions": 8,
    "multinode_certified": true,
    "environment": {"DOOR_FW_DATA_DIR": "/srv/bbs/netbbs.db.doors/fair_winds"}
  }
}
